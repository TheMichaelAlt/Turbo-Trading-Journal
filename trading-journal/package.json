{
  "name": "trading-journal",
  "private": true,
  "version": "1.3.2",
  "description": "A customizable trading journal with local storage, detailed analytics, and compact trade entry.",
  "author": "Turbo Trading Journal",
  "type": "module",
  "scripts": {
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --mode browser",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode browser",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/prepare-release.mjs",
    "test:release": "node tests/release.smoke.cjs",
    "test:upgrade": "node tests/installer-upgrade.smoke.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build && node tests/electron.smoke.cjs && node tests/startup.smoke.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.6"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24"
  }
}
